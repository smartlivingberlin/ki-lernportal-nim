{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone-assets.mjs",
    "prepare:standalone-assets": "node scripts/prepare-standalone-assets.mjs",
    "verify:standalone-assets": "node scripts/prepare-standalone-assets.mjs --verify",
    "start": "sh -c 'if [ -f .next/standalone/server.js ]; then node .next/standalone/server.js; elif [ -f .next/standalone/apps/web/server.js ]; then node .next/standalone/apps/web/server.js; else echo \"Standalone server.js not found\"; find .next/standalone -maxdepth 6 -name server.js -print; exit 1; fi'",
    "lint": "eslint"
  },
  "dependencies": {
    "@ki-lernportal-nim/auth": "file:./vendor/auth",
    "@ki-lernportal-nim/contracts": "file:./vendor/contracts",
    "@ki-lernportal-nim/domain": "file:./vendor/domain",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@5": "5.0.9",
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
