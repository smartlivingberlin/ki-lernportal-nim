APP_ENV=development

# S51B-B example format only. Never commit real credentials.
# The database runtime remains inactive until initialize() is called explicitly.
DATABASE_URL=mysql://change_me_user:change_me_password@127.0.0.1:3306/change_me_database
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_LIMIT=3
DB_QUEUE_LIMIT=10

# S52 auth runtime (default off). Staging-only flip is operator-controlled.
# AUTH_RUNTIME=true

# Freigabe D – staging memory bootstrap (names only; never commit real values).
# Prefer a precomputed nim-scrypt-v1 hash. Never set these on production.
# STAGING_BOOTSTRAP_EMAIL=
# STAGING_BOOTSTRAP_PASSWORD_HASH=
# STAGING_BOOTSTRAP_SUBJECT_ID=staging-bootstrap
# STAGING_BOOTSTRAP_ROLE=Learner

QDRANT_URL=http://localhost:6333
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
