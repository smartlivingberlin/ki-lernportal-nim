{
  "name": "ki-lernportal-nim",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "22.22.1",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --filter \"./services/*\" dev",
    "build": "pnpm --filter \"./apps/*\" --filter \"./services/*\" build",
    "lint": "pnpm --filter \"./apps/*\" --filter \"./services/*\" lint",
    "content:check": "node scripts/check-content-quality.mjs",
    "test:s48b-a11y": "node scripts/check-s48b-accessibility.cjs",
    "test:s50d1-privacy-overflow": "node scripts/check-s50d1-privacy-overflow.cjs",
    "test:s50d2-security-headers": "node scripts/check-s50d2-security-headers.cjs",
    "source:check": "node scripts/check-source-integrity.mjs",
    "test:s48c-sources": "node scripts/check-s48c-source-ui.cjs",
    "test:s49d-practice-ui": "node scripts/check-s49d-practice-ui.cjs",
    "supply-chain:check": "node scripts/check-supply-chain-policy.mjs",
    "governance:check": "node scripts/check-github-governance.mjs",
    "packages:boundaries": "node scripts/check-package-boundaries.mjs",
    "packages:typecheck": "node scripts/check-package-boundaries.mjs --typecheck",
    "railway:web-vendor:sync": "node scripts/sync-web-railway-vendor.mjs",
    "railway:web-vendor:check": "node scripts/sync-web-railway-vendor.mjs --check",
    "railway:web-npm-isolation": "node scripts/check-railway-web-npm-isolation.mjs",
    "railway:web-npm-isolation:install": "node scripts/check-railway-web-npm-isolation.mjs --install",
    "test:s51b-b-db-runtime": "node --experimental-strip-types packages/db/src/runtime-config.test.ts && node --experimental-strip-types packages/db/src/mysql-runtime.test.ts",
    "test:s51b-c1-pilot-schema": "node --experimental-strip-types packages/db/src/pilot-schema.test.ts",
    "test:s51b-c2-local-mysql": "bash scripts/test-s51b-c-local-mysql.sh",
    "test:s51c-b1a-pilot-domain": "node --experimental-strip-types packages/domain/src/pilot-domain.test.ts",
    "test:s51c-b1b-local-progress-import": "node --experimental-strip-types packages/contracts/src/local-progress-import.test.ts",
    "test:s51c-ops-a-operations": "node --experimental-strip-types packages/contracts/src/operations.test.ts",
    "test:s52-a-auth-policy": "node --experimental-strip-types packages/auth/src/platform-roles.test.ts && node --experimental-strip-types packages/auth/src/session-policy.test.ts",
    "test:s52-b-auth-runtime": "node --experimental-strip-types packages/auth/src/password-hashing.test.ts && node --experimental-strip-types packages/auth/src/session-token.test.ts && node --experimental-strip-types packages/auth/src/session-cookie.test.ts && node --experimental-strip-types packages/auth/src/session-runtime.test.ts",
    "test:s52-d1-auth-http": "node --experimental-strip-types packages/auth/src/auth-http.test.ts",
    "test:s52-c-auth-web-scope": "node scripts/check-s52-c-auth-web-scope.mjs",
    "test:s52-d-auth-web-impl-scope": "node scripts/check-s52-d-auth-web-impl-scope.mjs",
    "packages:verify": "pnpm packages:boundaries && pnpm packages:typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "playwright": "1.55.1"
  }
}
